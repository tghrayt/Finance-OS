{
  "name": "finance-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build:backend": "dotnet build FinanceOS.slnx",
    "test:backend": "dotnet test FinanceOS.slnx",
    "build:web": "npm --workspace apps/web run build",
    "test:web": "npm --workspace apps/web run test -- --watch=false",
    "build": "npm run build:backend && npm run build:web"
  },
  "devDependencies": {
    "nx": "23.1.1"
  }
}
